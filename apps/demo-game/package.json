{
  "name": "@devappstore/demo-game",
  "version": "0.1.0",
  "private": true,
  "description": "Faux jeu + faux serveur du studio Nova Games : démontre la livraison automatique des achats Dev AppStore.",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @devappstore/sdk",
    "dev": "tsx watch src/main.ts",
    "prestart": "npm run build -w @devappstore/sdk",
    "start": "tsx src/main.ts",
    "pretest": "npm run build -w @devappstore/sdk",
    "test": "vitest run",
    "pretypecheck": "npm run build -w @devappstore/sdk",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devappstore/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@devappstore/core": "*",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
