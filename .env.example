# Base de données — laisser vide en local : PGlite (Postgres embarqué) est utilisé dans .data/pglite
DATABASE_URL=
# Secret de session (openssl rand -hex 32)
AUTH_SECRET=change-me
APP_URL=http://localhost:3000
# Stripe (mode test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Commission plateforme en points de base (500 = 5 %)
PLATFORM_FEE_BPS=500
# Paiements (tâche payments) — optionnel : secret de l’endpoint webhook « comptes connectés » (account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Protège GET /api/cron/deliveries (Authorization: Bearer <CRON_SECRET>) — obligatoire en production ; vide = accepté seulement en dev
CRON_SECRET=
# Authentification (Better Auth) : AUTH_SECRET ci-dessus (ou BETTER_AUTH_SECRET) signe les sessions.
# URL publique du site si différente d'APP_URL.
BETTER_AUTH_URL=
# Connexion Google / Apple — facultatif : les boutons n'apparaissent que si ces variables sont renseignées.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Paiements (tâche payments, sécurité) — voir apps/web/src/server/stripe.ts
# En production : STRIPE_SECRET_KEY obligatoire (sinon 503, jamais de simulation), clé sk_live_ exigée ;
# WOLLEEN_ALLOW_TEST_PAYMENTS=1 autorise une clé sk_test_ (préproduction uniquement). APP_URL obligatoire.
WOLLEEN_ALLOW_TEST_PAYMENTS=
# Modèle de charge Stripe Connect : destination (défaut) | direct — choix TVA non tranché, ne pas changer sans décision.
CHARGE_MODEL=destination
# Stripe Tax (automatic_tax) : désactivé par défaut ; 1 = activé, prix traités TTC.
STRIPE_AUTOMATIC_TAX=
# Version des CGV acceptées, stockée sur chaque commande avec la renonciation au droit de rétractation.
WOLLEEN_CGV_VERSION=
# GET /api/checkout/expire (expiration des commandes pending > 24 h) exige aussi CRON_SECRET (refus si vide).
