# Base de données — laisser vide en local : PGlite (Postgres embarqué) est utilisé dans .data/pglite
DATABASE_URL=
# Secret de session (openssl rand -hex 32)
AUTH_SECRET=change-me
APP_URL=http://localhost:3000
# Stripe (mode test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Commission plateforme en points de base (500 = 5 %)
PLATFORM_FEE_BPS=500
# Paiements (tâche payments) — optionnel : secret de l’endpoint webhook « comptes connectés » (account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Protège les tâches planifiées /api/cron/deliveries, /api/cron/loyalty, /api/cron/weekly-reports et /api/checkout/expire
# (Authorization: Bearer <CRON_SECRET>, temps constant) — obligatoire en production (≥ 16 caractères) ;
# vide = accepté seulement en développement (NODE_ENV=development), 503 ailleurs. Planning : apps/web/vercel.json.
CRON_SECRET=
# Authentification (Better Auth) : AUTH_SECRET ci-dessus (ou BETTER_AUTH_SECRET) signe les sessions.
# URL publique du site si différente d'APP_URL.
BETTER_AUTH_URL=
# Connexion Google / Apple — facultatif : les boutons n'apparaissent que si ces variables sont renseignées.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Paiements (tâche payments, sécurité) — voir apps/web/src/server/stripe.ts
# En production : STRIPE_SECRET_KEY obligatoire (sinon 503, jamais de simulation), clé sk_live_ exigée ;
# DEVAPPSTORE_ALLOW_TEST_PAYMENTS=1 autorise une clé sk_test_ (préproduction uniquement). APP_URL obligatoire.
DEVAPPSTORE_ALLOW_TEST_PAYMENTS=
# Modèle de charge Stripe Connect : destination (défaut) | direct — choix TVA non tranché, ne pas changer sans décision.
CHARGE_MODEL=destination
# Stripe Tax (automatic_tax) : désactivé par défaut ; 1 = activé, prix traités TTC.
STRIPE_AUTOMATIC_TAX=
# Version des CGV acceptées, stockée sur chaque commande avec la renonciation au droit de rétractation (citée dans le reçu).
DEVAPPSTORE_CGV_VERSION=
# Lien des CGV dans le reçu d'achat (défaut : {APP_URL}/legal/cgv).
CGV_URL=
# Validation : toutes les variables serveur sont vérifiées au démarrage par apps/web/src/env.ts (instrumentation.ts) ;
# le serveur refuse de démarrer si la configuration est invalide (SKIP_ENV_VALIDATION=1 pour l'outillage seulement, ignorée en production).
# Origines supplémentaires acceptées par Better Auth (séparées par des virgules).
BETTER_AUTH_TRUSTED_ORIGINS=
# E-mails transactionnels (@devappstore/emails) : console + .data/mails en dev, Resend si RESEND_API_KEY est défini.
RESEND_API_KEY=
# console | resend (défaut : resend si RESEND_API_KEY, sinon console). Production : RESEND_API_KEY obligatoire, console refusé.
MAIL_TRANSPORT=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_CONSOLE_DIR=
SUPPORT_EMAIL=
# Points Dev AppStore (programme de fidélité) — 1 pour l'ouvrir en production (actif par défaut hors production).
LOYALTY_ENABLED=
# Centimes de commission Dev AppStore par point (défaut 10), validité des points en jours (365), coût max d'une récompense (2000 = 20 %).
LOYALTY_FEE_CENTS_PER_POINT=
LOYALTY_POINTS_TTL_DAYS=
LOYALTY_MAX_COST_BPS=
# Stockage des uploads : local (disque .data/uploads, défaut) | s3 (Cloudflare R2 / S3) — voir docs/deploy-storage.md
DEVAPPSTORE_STORAGE=local
# R2 : https://<account_id>.eu.r2.cloudflarestorage.com (sans le bucket)
S3_ENDPOINT=
# auto pour R2 ; région réelle pour AWS (ex. eu-west-3)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique du bucket / CDN, sans / final (ex. https://cdn.devappstore.eu)
S3_PUBLIC_URL=
# Même valeur que S3_PUBLIC_URL (https), exposée au navigateur : les composants de boutique (rendus aussi côté client)
# n'affichent une image absolue que si elle est sous cette base (style-safety.ts → safeImageUrl). Obligatoire en
# production avec DEVAPPSTORE_STORAGE=s3 ; injectée au build (next build) : rebuild après changement.
NEXT_PUBLIC_S3_PUBLIC_URL=
# Plusieurs instances (docs/deploy.md, « Plusieurs instances ») :
# relais des événements de livraison : postgres (défaut si DATABASE_URL) | pglite (défaut en local) | memory
EVENTS_TRANSPORT=
# URL Postgres directe, sans pooler (LISTEN) ; défaut : DATABASE_URL
EVENTS_DATABASE_URL=
# Compteurs des limiteurs de débit : memory (défaut, par instance) | postgres (partagés, table rate_limit_counters)
RATE_LIMIT_STORE=
