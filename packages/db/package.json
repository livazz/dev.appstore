{
  "name": "@devappstore/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "push": "node -e \"require('fs').mkdirSync(process.env.DEVAPPSTORE_DATA_DIR ? process.env.DEVAPPSTORE_DATA_DIR + '/pglite' : '../../.data/pglite', {recursive: true})\" && drizzle-kit push --force",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@devappstore/core": "*",
    "drizzle-orm": "^0.45.4",
    "@electric-sql/pglite": "^0.3.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "better-auth": "^1.7.18",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0",
    "@types/node": "^20"
  }
}
