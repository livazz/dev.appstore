{
  "name": "devappstore",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev -w @devappstore/web",
    "build": "npm run build -w @devappstore/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @devappstore/e2e",
    "db:push": "npm run push -w @devappstore/db",
    "db:seed": "npm run seed -w @devappstore/db",
    "db:migrate": "npm run db:migrate -w @devappstore/db",
    "demo": "npm run dev -w @devappstore/demo-game"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "@electric-sql/pglite": "^0.3.7"
  }
}
